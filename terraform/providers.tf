terraform {
  required_version = ">= 1.5.0"

  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.31"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.14"
    }
  }
}

# This module targets an EXISTING Kubernetes cluster. It never provisions
# control plane / worker nodes / networking / cluster storage infrastructure.
#
# Auth against the cluster via a kubeconfig context, consistent with how a
# platform engineer would normally interact with a cluster they don't own
# the lifecycle of.
provider "kubernetes" {
  config_path    = var.kubeconfig_path
  config_context = var.kube_context
}

provider "helm" {
  kubernetes {
    config_path    = var.kubeconfig_path
    config_context = var.kube_context
  }
}
