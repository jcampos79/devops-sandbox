# Copy to .env for local development. Never commit a real .env.
# In-cluster, these are supplied via the ConfigMap/Secret the Helm chart
# creates (see helm/sandbox-platform/values.yaml backend.config /
# backend.existingSecretName) -- not this file.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sandbox
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=changeme

BACKEND_SECRET_KEY=dev-only-change-me

SANDBOX_NAMESPACE_PREFIX=sandbox-
MAX_INSTANCE_DURATION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=30
TICKET_TTL_SECONDS=45
LOG_LEVEL=INFO

SANDBOX_IMAGE_UBUNTU=
SANDBOX_IMAGE_ROCKY=
SANDBOX_IMAGE_DEBIAN=
SANDBOX_IMAGE_ALPINE=
SANDBOX_CPU=1
SANDBOX_MEMORY=512Mi

# When unset, the Kubernetes client falls back to in-cluster config (the
# normal case when running inside the platform namespace).
KUBECONFIG_PATH=
